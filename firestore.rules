rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Security Helper Functions
    // ==========================================
    
    /// Checks if the requesting user is authenticated via Firebase Auth
    function signedIn() {
      return request.auth != null;
    }

    /// Validates that the requesting user's UID strictly matches the document owner UID
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    /// Prevents client from altering or falsifying internal UID fields
    function isImmutableUid(userId) {
      return !('uid' in request.resource.data) || request.resource.data.uid == userId;
    }

    // ==========================================
    // User Profile & Tenant Isolation Rules
    // ==========================================
    
    match /users/{userId} {
      // User profile document permissions (CRUD restricted strictly to document owner)
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isImmutableUid(userId);
      allow update: if isOwner(userId) && isImmutableUid(userId);
      allow delete: if isOwner(userId);

      // Subcollection: food_logs (Nutrition diary & logged meals)
      match /food_logs/{foodLogId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: workout_logs (Completed workout sessions & exercise logs)
      match /workout_logs/{workoutLogId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: routines (User custom & AI-generated workout routines)
      match /routines/{routineId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: daily_logs (Aggregated daily tracking - steps, water, calories)
      match /daily_logs/{dateStr} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // Default Deny Rule for Unknown Collections
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
