rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User-scoped food images: only authenticated users can read and write their own images
    match /users/{uid}/food_images/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
