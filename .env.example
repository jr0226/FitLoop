# ==============================================================================
# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT
# ==============================================================================

# Backend API / Cloud Functions Proxy Configuration (Recommended)
# When running the mobile app pointing to your backend:
API_BASE_URL=https://your-backend-api-or-cloud-functions-url.com

# Backend Environment Variables (Store on your server / Firebase Cloud Functions config)
# NEVER compile these directly into the public mobile app binary!
GEMINI_API_KEY=your_gemini_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
API_NINJAS_KEY=your_api_ninjas_key_here
PORT=8080

# Android Signing Keystore Configuration (Used by android/key.properties)
# STORE_FILE_PATH=upload-keystore.jks
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
# STORE_PASSWORD=your_store_password
